using System;
using System.Collections.Generic;
using OpamLab07;

const int N = 17;
const int K = 20;
const int a = 2;
const int b = 1;
const int c = 2;

Console.OutputEncoding = System.Text.Encoding.UTF8;

Console.WriteLine($"N = {N}, K = {K}, a = {a}, b = {b}, c = {c}");
Console.WriteLine("Лабораторна робота №7\n");

// Дані
Random random = new Random(N);
List<int> numbers = new List<int>();

for (int i = 0; i < 20; i++)
    numbers.Add(random.Next(-K, K + 1));

List<string> words = new List<string>
{
    "кіт", "програмування", "веб-сайт", "алгоритм",
    "комп'ютер", "сонце", "будь-який", "книга",
    "узагальнення", "рядок", "дані", "студент",
    "синьо-жовтий", "програма"
};

List<Student> students = new List<Student>
{
    new Student("Мойсєєць Павло", "КН-3/1", 92),
    new Student("Іваненко Олена", "КН-3/1", 78),
    new Student("Петренко Андрій", "КН-3/2", 64),
    new Student("Шевченко Марія", "КН-2/1", 55),
    new Student("Коваль Ігор", "КН-3/1", 87),
    new Student("Бондар Софія", "КН-2/2", 73),
    new Student("Мельник Денис", "КН-3/2", 45),
    new Student("Ткачук Анна", "КН-3/1", 60),
    new Student("Романюк Олег", "КН-2/1", 100),
    new Student("Лисенко Юлія", "КН-3/2", 89),
    new Student("Кравець Назар", "КН-2/2", 32),
    new Student("Олійник Дарина", "КН-3/1", 75)
};

Console.WriteLine("Числа:");
PrintList(numbers);

Console.WriteLine("\n=== Завдання 1: Filter ===");

var filteredNumbers =
    Algorithms.Filter(numbers, x => x <= 0);

var filteredWords =
    Algorithms.Filter(words, s => s.Contains('-'));

var filteredStudents =
    Algorithms.Filter(students,
        s => s.Score >= 60 && s.Score <= 89);

Console.WriteLine("Числа <= 0:");
PrintList(filteredNumbers);

Console.WriteLine("Рядки з дефісом:");
PrintList(filteredWords);

Console.WriteLine("Студенти з балом 60–89:");
PrintList(filteredStudents);

Console.WriteLine("Тіло Filter змінювалося: 0 разів.");

Console.WriteLine("\n=== Завдання 2: Map ===");

int divisor = K % 7 + 2;

var mappedNumbers =
    Algorithms.Map(numbers,
        x => ((x % divisor) + divisor) % divisor);

var mappedWords =
    Algorithms.Map(words,
        s => s.ToUpperInvariant());

var mappedStudents =
    Algorithms.Map(students,
        s => s.Surname);

Console.WriteLine("Числа — остача від ділення на 8:");
PrintList(mappedNumbers);

Console.WriteLine("Рядки — верхній регістр:");
PrintList(mappedWords);

Console.WriteLine("Студенти — прізвища:");
PrintList(mappedStudents);

Console.WriteLine("\n=== Завдання 3: Aggregate ===");

long sum = Algorithms.Aggregate(
    numbers, 0L, (acc, x) => acc + x);

long product = Algorithms.Aggregate(
    numbers, 1L, (acc, x) => acc * x);

Console.WriteLine($"Сума: {sum}");
Console.WriteLine($"Добуток: {product}");

if (numbers.Count > 0)
{
    int maximum = Algorithms.Aggregate(
        numbers, int.MinValue,
        (acc, x) => x > acc ? x : acc);

    Console.WriteLine($"Максимум: {maximum}");
}
else
{
    Console.WriteLine("Максимум не визначений: список порожній.");
}

string joinedWords = Algorithms.Aggregate(
    words, "",
    (acc, s) => acc == "" ? s : acc + ", " + s);

Console.WriteLine($"Рядки через кому: {joinedWords}");

Console.WriteLine("\n=== Завдання 4: GroupBy ===");

var groupsByGroup =
    Algorithms.GroupBy(students, s => s.Group);

PrintGroups("За групою", groupsByGroup);

var groupsBySurname =
    Algorithms.GroupBy(students, s => s.Surname[0]);

PrintGroups("За першою літерою прізвища", groupsBySurname);

var groupsByScore =
    Algorithms.GroupBy(students, s =>
        s.Score <= 59 ? "0–59" :
        s.Score <= 74 ? "60–74" :
        s.Score <= 89 ? "75–89" : "90–100");

PrintGroups("За діапазоном балів", groupsByScore);

var groupsByLength =
    Algorithms.GroupBy(words, s => s.Length);

PrintGroups("Рядки за довжиною", groupsByLength);

Console.WriteLine("\n=== Завдання 5: Захоплення змінних ===");

// 1. Змінна після лямбди
int threshold = K;

Func<int, bool> check = x => x > threshold;

threshold = 1000;

Console.WriteLine(
    $"1. Поріг = {threshold}; 50 > поріг: {check(50)}");

// 2. Цикл for
List<Func<int>> forFunctions = new List<Func<int>>();

for (int i = 0; i < 3; i++)
{
    forFunctions.Add(() => i);
}

Console.WriteLine("2. for:");

foreach (var function in forFunctions)
    Console.WriteLine(function());

// 3. Цикл foreach
List<Func<int>> foreachFunctions = new List<Func<int>>();

foreach (int item in new int[] { 0, 1, 2 })
{
    foreachFunctions.Add(() => item);
}

Console.WriteLine("3. foreach:");

foreach (var function in foreachFunctions)
    Console.WriteLine(function());

Console.WriteLine(
    "Виправлення for: створити локальну копію i в кожній ітерації.");

Console.WriteLine("\nЛабораторну роботу завершено.");

static void PrintList<T>(List<T> list)
{
    Console.WriteLine(string.Join(", ", list));
}

static void PrintGroups<TKey, T>(
    string title,
    Dictionary<TKey, List<T>> groups) where TKey : notnull
{
    Console.WriteLine($"\n{title}:");

    foreach (var group in groups)
    {
        Console.WriteLine(
            $"{group.Key}: {group.Value.Count} елементів");
    }
}